# === Discord Bot ===
DISCORD_TOKEN=your_bot_token_here
MAIN_GUILD_ID=0
OWNER_ID=0

# === Web Admin Panel ===
DISCORD_CLIENT_ID=your_app_client_id
DISCORD_CLIENT_SECRET=your_app_client_secret
DISCORD_REDIRECT_URI=https://your-app.up.railway.app/auth/callback
SECRET_KEY=replace-with-long-random-string

# Comma-separated Discord role IDs that grant access to admin panel (in addition to Administrator perm)
ADMIN_ROLE_IDS=

# === Misc ===
LOG_LEVEL=INFO
DB_PATH=database/bot.db
MAJESTIC_SERVER_IDS=
