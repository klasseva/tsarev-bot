# Discord Bot Token (https://discord.com/developers/applications)
DISCORD_TOKEN=your_token_here

# Главная гильдия (для мгновенной регистрации slash-команд при разработке)
MAIN_GUILD_ID=0

# Владелец бота (Discord user ID)
OWNER_ID=0

# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Путь к БД
DB_PATH=database/bot.db

# Majestic RP — ID серверов для мониторинга (через запятую)
MAJESTIC_SERVER_IDS=1,2,3
